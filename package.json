{
  "name": "skyrim-modding-tools-core",
  "version": "0.1.22",
  "description": "The core of the Skyrim SE modding tools: records across a mod manager's load order, mods and patches authored as text projects and built into plugins, and the tools, guides and skills for them, served by skyrim-modding-tools-mcp and its OpenClaw plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fakes.d.ts",
      "default": "./dist/testing/fakes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "helper/SkyrimHelper",
    "helper/bin",
    "scripts",
    "CONTEXT.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "build": "tsc",
    "prepare": "tsc",
    "build:helper": "node scripts/build-helper.mjs",
    "check:helper": "node scripts/check-helper.mjs"
  },
  "keywords": [
    "skyrim",
    "skyrim-special-edition",
    "modding",
    "mod-organizer",
    "amethyst",
    "mutagen",
    "spriggit"
  ],
  "author": "Andreas Breit",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
