{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "es2022",                      /* Node 24 runs ES2022 natively; nothing older needs downlevelling. */
    "module": "esnext",
    "moduleResolution": "bundler",           /* Resolve the ESM-style './Foo.js' specifiers the sources use against their .ts originals. */
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,                     /* The products compile against the core: they need its types beside its JavaScript. */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  }
}
